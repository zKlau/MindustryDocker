# Copy to .env (or set these as environment variables in Coolify).

# Port players connect to on the host. It maps to Mindustry's port 6567 inside the container (TCP + UDP).
SERVER_PORT=6567

# Password for the web dashboard. Leave empty to disable the dashboard.
ADMIN_PASSWORD=

# Host port for the web dashboard (plain HTTP). Expose it with a Cloudflare Tunnel for HTTPS.
DASHBOARD_PORT=8080

# "latest" or a release tag from https://github.com/Anuken/Mindustry/releases (e.g. v156.2).
# Changing this requires a rebuild.
MINDUSTRY_VERSION=latest

# Shown in the server browser. Leave empty to keep the default / whatever you set in the dashboard.
# Don't use commas.
MINDUSTRY_SERVER_NAME=

# Console commands run at startup, comma-separated. Used on the very first start (no save yet),
# or always if you pick "Use MINDUSTRY_START_COMMANDS" in the dashboard's Settings tab.
# Examples: "config port 6567,host"  or  "config port 6567,host Ancient_Caldera survival"
MINDUSTRY_START_COMMANDS=config port 6567,host

# JVM options, e.g. max memory.
JAVA_OPTS=-Xmx1G
